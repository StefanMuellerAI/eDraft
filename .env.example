# Kopieren nach .env und bei Bedarf anpassen.

# Port, unter dem die Anwendung intern erreichbar ist
EDRAFT_PORT=8080

# Mock-Verhalten des Konverter-Endpunkts (§8.2):
#   sample           -> liefert eine valide Beispiel-FDX (Status "ok")
#   not_implemented  -> liefert die definierte "noch nicht verfügbar"-Antwort (HTTP 202)
EDRAFT_CONVERT_MODE=sample

# Maximale Upload-Größe für den Konverter (MB)
EDRAFT_MAX_UPLOAD_MB=20

# Vorbereitete Toggles für spätere Ausbaustufen (im MVP ohne Wirkung)
EDRAFT_AUTH_ENABLED=false
# EDRAFT_DATABASE_URL=postgresql://edraft:edraft@db:5432/edraft
